# Profile: Qwen3.8-Flash-Next AWQ-INT4, PP=2 + MTP=2, PLE table on NVMe, port 8008.
#
# This is the profile the published benchmarks were taken with; adjust the paths
# (VLLM_BIN, MODEL, PLE_SSD_LIB) to your machine. Read ../INSTALL.md first.

# --- engine, model, endpoint --------------------------------------------------
VLLM_BIN=/srv/models/vllm/flashnext-env/bin/vllm
MODEL=/srv/models/vllm/flashnext-awq-int4
SERVED_NAME=Qwen3.8-Flash-Next-AWQ-INT4
HOST=0.0.0.0
PORT=8008

# Optional Bearer auth. Empty means open access; any non-empty value makes the
# engine start with --api-key, so /v1, /v2, /inference and /cohere then require
# `Authorization: Bearer <key>`, while /health and /metrics stay open. A key
# change needs an engine restart. Keep the real key out of a public repository.
API_KEY=

# --- cards and parallelism ----------------------------------------------------
# PP=2 because these cards have no peer-to-peer link: TP would send one
# all-reduce per layer through the host. Requires patch 07.
CUDA_DEVICES=0,1
PP_SIZE=2
# 26,22 instead of 24,24: the last stage also carries the MTP drafter, so an even
# split loads it with more weights than the first stage. Start time equals the
# slowest stage, and the balanced split adds 15 % KV cache.
# The PLE layer (ple_layer_ids=[2]) must stay on rank 0 - patch 07 checks that.
VLLM_PP_LAYER_PARTITION=26,22

# --- context and batching -----------------------------------------------------
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=8
# 4096 beats 2048 on this hardware: prefill@32768 8330 vs 7522 tok/s, decode
# 121 vs 97 tok/s, for 0.7 % of the KV cache. 8192 is better on very long prompts
# and worse on medium ones and costs 6.3 % KV. See ../BENCHMARKS.md.
MAX_BATCH_TOKENS=4096
# 0.90, not 0.95: the free-VRAM plateau of a long-running engine drops, and an
# engine that starts at 0.95 can leave too little room for a second process.
# At 0.90, with the INT8 KV cache below, this profile gives a 1 352 663 token KV
# cache on two 64 GiB cards (5.16x the 262 144 token context).
GPU_MEMORY=0.90
MTP=2
# KV cache quantization: int8 with a scale per (token, head). SM80 has no FP8
# tensor cores and Triton on sm_80 has no `fp8e4nv`, so `fp8_e4m3` here is a
# bit-hack that costs about a third of decode; INT8 widens natively and costs
# nothing measurable (125 -> 123 tok/s) while the pool grows 744 431 -> 1 352 663
# tokens. Needs patch 16; without it the engine refuses this value. To go back to
# BF16 KV, comment the line out (or set KV_DTYPE=auto).
KV_DTYPE=int8_per_token_head

# --- PLE table on NVMe --------------------------------------------------------
PLE_SSD_OFFLOAD=1
PLE_SSD_WORKERS=16
PLE_SSD_CACHE_MB=512
PLE_SSD_IO_DEPTH=256
PLE_SSD_PREFETCH=16384
# Built by the recipe (scripts/install-runtime.sh); point this at your build.
PLE_SSD_LIB=/srv/models/vllm/flashnext-opt/ple_ssd_io.so

# --- compilation --------------------------------------------------------------
# 1 = cudagraph without Inductor (measured best for prefill here), 0 = none,
# 3 = full VLLM_COMPILE.
COMPILE_MODE=1
GRAPH_MODE=FULL_AND_PIECEWISE
VLLM_USE_BREAKABLE_CUDAGRAPH=1

EXTRA_FLAGS="--enable-expert-parallel --async-scheduling"

# --- weight loading -----------------------------------------------------------
# Patch 06: the non-PLE weights are loaded with InstantTensor instead of mmap.
# mmap kept ~23 GiB of page cache on a 30 GiB host, pushed the working set into
# swap and made the start take 680/628 s; with instanttensor the start takes
# 150-166 s, page cache stays at 5.4 GiB and swap stays near zero. Allowed
# values: safetensors (mmap, default) | instanttensor | fastsafetensors.
VLLM_PLE_NONPLE_LOADER=instanttensor

# --- runtime refusal abliteration (patch 14) ----------------------------------
# The value is a JSON file with a refusal_direction list, a safetensors file with
# a refusal_direction tensor, or a bare name resolved inside the module's
# BUILTIN_DIR. Empty (or 0, or unset) means off: nothing is loaded, no work is
# added, so removing a refusal is an explicit decision, never a side effect.
# The direction is not shipped here: it belongs to
# orcarouter/Qwen3.8-Flash-Next-Uncensored (Apache-2.0).
QWEN38_ABLITERATION=