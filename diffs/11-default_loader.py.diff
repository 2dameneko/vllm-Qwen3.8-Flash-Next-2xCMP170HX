+    def _init_pp_weight_filter(self, model_config: ModelConfig) -> None:
+        """Record the hidden layers owned by this pipeline stage.
+
+        Kept separate from _init_ep_weight_filter on purpose: the EP
+        filter only arms itself when expert parallelism actually spans
+        more than one rank (its ep_size = dp*pcp*tp excludes PP), so it
+        stays dormant in the PP2 profile while the pipeline filter does
+        not.  Failure to determine the layer count disables the filter
+        instead of breaking the start.
+        """
+        from vllm.config import get_current_vllm_config
+
+        parallel_config = get_current_vllm_config().parallel_config
+        pp_size = parallel_config.pipeline_parallel_size
+        if pp_size <= 1:
+            return
+
+        num_layers = getattr(
+            model_config.hf_text_config, "num_hidden_layers", None
+        )
+        if not num_layers:
+            logger.warning_once(
+                "PP weight filter disabled: unknown num_hidden_layers."
+            )
+            return
+
+        from vllm.distributed import get_pp_group
+
+        pp_rank = get_pp_group().rank_in_group
+        self.local_layers = compute_local_layer_ids(
+            int(num_layers), pp_size, pp_rank
+        )
+        layers = self.local_layers.layers
+        logger.info_once(
+            "PP weight filter: pp_rank=%d/%d keeps layers %d..%d "
+            "(mtp=%s); foreign-layer tensors are skipped before they "
+            "are read from disk",
+            pp_rank,
+            pp_size,
+            layers.start,
+            layers.stop - 1,
+            self.local_layers.owns_mtp,
+        )
+
