+++ b/vllm/models/qwen4_exp/nvidia/abliteration.py
+# SPDX-License-Identifier: Apache-2.0
+"""Optional refusal-direction removal ("abliteration") applied at runtime.
+
+Ported from the 2x3090 Qwen3.8-Flash-Next overlay
+(github.com/DominikBucko/qwen38-flash-next-2x3090, runtime/vllm-overlay,
+Apache-2.0). The direction is recovered from the Apache-2.0 release
+orcarouter/Qwen3.8-Flash-Next-Uncensored (Arditi et al., 2024).
+
+``QWEN38_ABLITERATION`` names a JSON file with a ``refusal_direction`` list, or
+a safetensors file with a ``refusal_direction`` tensor, of length
+``hidden_size``. A bare name such as ``orcarouter`` resolves to
+``/srv/models/vllm/abliteration/<name>.json``. With it set, every
+residual-stream write loses its component along the unit direction r:
+
+    x <- x - r (r . x)
+
+applied to the attention and linear-attention block outputs, the MoE block
+output (routed plus shared experts), the PLE value projection and the text
+token embeddings. For one direction this equals the weight edit
+``W' = W - r (r^T W)`` on ``self_attn.o_proj``, ``linear_attn.out_proj``,
+every expert's and the shared expert's ``down_proj``, ``ple.value_proj`` and
+the rows of ``embed_tokens``. All weights stay untouched. Unset or ``0``,
+nothing is loaded and no work is added.
+"""
+
+import json
+import math
+import os
+
+import torch
+
+ENV = "QWEN38_ABLITERATION"
+BUILTIN_DIR = "/srv/models/vllm/abliteration"
+
+
+def direction_path() -> str | None:
+    """Resolve the switch into a file path, or None when it is off."""
+    value = os.environ.get(ENV, "").strip()
+    if value in ("", "0"):
+        return None
+    if os.sep not in value and not value.endswith((".json", ".safetensors")):
+        value = os.path.join(BUILTIN_DIR, f"{value}.json")
+    return value
+
+
+def load_direction(hidden_size: int) -> torch.Tensor | None:
+    """The unit refusal direction as a float32 CPU tensor, or None when off."""
+    path = direction_path()
+    if path is None:
+        return None
+    if path.endswith(".json"):
+        with open(path) as f:
+            r = torch.tensor(json.load(f)["refusal_direction"], dtype=torch.float32)
+    else:
+        from safetensors import safe_open
+
+        with safe_open(path, framework="pt", device="cpu") as f:
+            r = f.get_tensor("refusal_direction")
+    r = r.to(torch.float32).flatten()
+    if r.numel() != hidden_size:
+        raise ValueError(
+            f"{ENV}: {path} holds {r.numel()} values; the model's hidden "
+            f"size is {hidden_size}"
+        )
+    norm = float(r.norm())
+    if not math.isfinite(norm) or norm == 0.0:
+        raise ValueError(f"{ENV}: {path} holds a zero or non-finite direction")
+    return r / norm
+
+
+def _offload_process() -> bool:
+    """True only in a CPU-only PLE-offload worker, if this tree has one.
+
+    Upstream's overlay calls ``ple_offload_layer.is_offload_process``; this
+    build has no such module (the PLE SSD offload runs the layer on the GPU),
+    so the probe is best-effort and defaults to False.
+    """
+    try:
+        from vllm.model_executor.layers.ple_offload_layer import is_offload_process
+    except Exception:
+        return False
+    try:
+        return bool(is_offload_process())
+    except Exception:
+        return False
+
+
+def register(module: torch.nn.Module, hidden_size: int, dtype: torch.dtype) -> None:
+    """Attach the direction as a non-persistent buffer ``_abliteration_r``.
+
+    Call inside a module constructor so the buffer lands on the module's device
+    before CUDA-graph capture. With the switch off the attribute is set to
+    None, so ``project_`` stays a no-op and nothing is loaded.
+    """
+    r = None if _offload_process() else load_direction(hidden_size)
+    if r is None:
+        module._abliteration_r = None
+        return
+    buf = torch.empty(hidden_size, dtype=dtype)
+    buf.copy_(r)
+    module.register_buffer("_abliteration_r", buf, persistent=False)
+
+
+def project_(x: torch.Tensor, r: torch.Tensor | None) -> torch.Tensor:
+    """In place: drop the component along r from x's last dim. No-op if None."""
+    if r is None:
+        return x
+    width = x.shape[-1]
+    if x.is_contiguous():
+        flat = x.view(-1, width)
+        flat.addr_(flat @ r, r, alpha=-1.0)  # rank-1 update, no full-size temp
+    else:
+        x.sub_(torch.outer(x.reshape(-1, width) @ r, r).view(x.shape))
+    return x
